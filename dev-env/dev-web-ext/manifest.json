{
  "name": "discord-automation dev tool",
  "description": "A development tool for the discord-automation project.",
  "icons": {
    "32": "icon.svg",
    "64": "icon.svg"
  },
  "version": "1.0",
  "manifest_version": 2,

  "browser_specific_settings": {
    "gecko": {
      "id": "discord-automation@dev.local"
    }
  },
  "background": {
      "scripts": ["background.js"]
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "discord-automation"
  },
  "page_action": {
    "default_icon": "icon.svg",
    "default_title": "discord-automation",
    "show_matches": ["*://*.discord.com/*"]
  },
  "user_scripts": {},
  "permissions": [
    "*://*.discord.com/*",
    "scripting",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.discord.com/*"],
      "js": ["content-script.js"]
    }
  ],
  "content_security_policy": "connect-src 'self' localhost"
}
